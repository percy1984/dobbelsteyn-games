# Routing en beveiliging voor de Angular-app (LiteSpeed op Hostinger leest dit net als Apache).
# Deze rules gelden voor de map waarin de app staat (bijvoorbeeld /games/) en vervangen
# de rewrite-rules van mappen erboven; ze bevatten geen vast pad of host.

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # De API heeft zijn eigen .htaccess en front controller.
    RewriteRule ^api/ - [L]

    # Bestaande bestanden en mappen gewoon serveren.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Al het andere is een route van de app (deep link, bijvoorbeeld een lobby): index.html.
    RewriteRule ^ index.html [L]
</IfModule>

# Nooit uitleveren: dotfiles en bronkaarten.
<FilesMatch "^\.(?!htaccess$)|\.map$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # index.html wijst naar bestanden met een hash in de naam: altijd opnieuw ophalen.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Bestanden met een hash in de naam veranderen nooit: lang cachen.
    <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
